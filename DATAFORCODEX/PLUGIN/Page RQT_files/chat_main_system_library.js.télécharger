// Implementated request method which uses a callback to report the success or failure of an XMLHttpRequest.
Chat.GetHttpRequest = function (query, resolve, reject) {
    var clientUrl = Xrm.Page.context.getClientUrl();
    if (clientUrl) {
        var req = new XMLHttpRequest()
        req.open("GET", encodeURI(clientUrl + query), true);
        req.setRequestHeader("Accept", "application/json");
        req.setRequestHeader("Content-Type", "application/json;charset=utf-8");
        req.setRequestHeader("OData-MaxVersion", "4.0");
        req.setRequestHeader("OData-Version", "4.0");
        req.onreadystatechange = function () {
            if (this.readyState == 4) {
                req.onreadystatechange = null;
                if (this.status >= 200 && this.status < 300) {
                    resolve(this.response);
                }
                else {
                    reject(this.statusText);
                }
            }
        };
        req.send(null);
    }
    else {
        reject(topMostWindow.jsErr_InvalidClientUrl);
    }
};

