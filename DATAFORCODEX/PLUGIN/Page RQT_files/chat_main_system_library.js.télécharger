// Verify the user role Id.
Chat.CheckUserChatRole = function (userRoleId, callback) {
    let checkRoles = function () {
        var currentUserRoles = Xrm.Page.context.getUserRoles();
        if (currentUserRoles != null) {
            for (var i = 0; i < currentUserRoles.length; i++) {
                var curRole = currentUserRoles[i];
                if (topMostWindow.chatUserRoleIds[curRole] && topMostWindow.chatUserRoleIds[curRole] === userRoleId) {
                    callback(true);
                    return;
                }

            }
        }
        callback(false);
    };
    if (!topMostWindow.chatUserRoleIds || topMostWindow.chatUserRoleIds.length == 0) {
        var query = "/api/data/v9.1/roles?$select=roleid,_parentrootroleid_value&$filter= _parentrootroleid_value eq " + agentRoleId
            + " or _parentrootroleid_value eq " + supervisorRoleId
            + " or _parentrootroleid_value eq " + chatAdministratorRoleId;
        Chat.GetHttpRequest(query,
			function success(data) {
			    if (data) {
			        var jsonData = JSON.parse(data);
			        if (jsonData.value) {
			            topMostWindow.chatUserRoleIds = {};
			            for (var i = jsonData.value.length - 1; i >= 0; i--) {
			                var curValue = jsonData.value[i];
			                if (curValue.roleid) {
			                    topMostWindow.chatUserRoleIds[curValue.roleid.toLowerCase()] = curValue._parentrootroleid_value.toLowerCase();
			                }
			            }
			            checkRoles();
			        }
			    }
			},
			function error(data) {
			    console.log("chat user roles are not present");
			    callback(false);
			});
    }
    else {
        checkRoles();
    }
};
Chat.CreateWidget = function () {
    try {
        if (topMostWindow.chatEnabledFlag === false) {
            return false;
        }
        else if (topMostWindow.agentWidgetUrl) {
            Chat.loadWidget(topMostWindow.agentWidgetUrl);
        }
        else {
            Chat.LoadAgentWidgetUrl(function(parseData){
                var chatEnabledFlag = parseData.value[0].cxlvhlp_islivehelpon;
                topMostWindow.chatEnabledFlag = false;
                if (chatEnabledFlag === true) {
                    topMostWindow.chatEnabledFlag = chatEnabledFlag;
                    var widgetUrl = parseData.value[0].cxlvhlp_agenturl + "&lcid=" + Xrm.Page.context.getUserLcid();
                    Chat.GetSolutionVersion(function success(version) {
                            widgetUrl = widgetUrl + "&CrmChatPkgVer=" + version;
                            Chat.loadWidget(widgetUrl);
                        },
                        function error(data) {
                            console.log(data);
                            Chat.loadWidget(widgetUrl);
                        });
                }
            });
        }
    }
    catch (ex) {
        console.log(ex.toString());
    }
};

