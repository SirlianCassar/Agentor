function setContactPostMessageInterval() {
    setInterval(function(){
        let contactId;
        try {
            contactId = Xrm.Page.data.entity.getId().replace("{", "").replace("}", "");
        } catch (e) {
            // this should fail in "create contact" forms
        }

        if (contactId) {
            postMessageContactInfo(contactId);
        }
    },1000);

    function postMessageContactInfo(contactId) {

        if(!canAccessWindowTop) {
            return;
        };

        for (var i = 0; i < window.top.frames.length; i++) {
            let payload;
            try {
                payload = {
                    messageName: "CRM_CONTACT_DATA",
                    data: {
                        isContactPage: true,
                        contactId: contactId,
                        firstName: Xrm.Page.getAttribute("firstname").getValue(),
                        lastName: Xrm.Page.getAttribute("lastname").getValue()
                    }
                }

                Chat.GetAgentWidgetUrl(function(agentWidgetUrl){
                    if (window.top.frames[i] != null) {
                        window.top.frames[i].postMessage(JSON.stringify(payload), agentWidgetUrl);
                    }
                });
            } catch (e) {

            }
        }
    }
}

