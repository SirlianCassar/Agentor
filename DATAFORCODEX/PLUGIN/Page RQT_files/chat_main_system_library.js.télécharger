Chat.ChatActivityCustomerUpdated = function () {

    if(!canAccessWindowTop) {
        return;
    };

    let customer = Xrm.Page.getAttribute("cxlvhlp_customer") ? Xrm.Page.getAttribute("cxlvhlp_customer").getValue() : null;
    if (customer && customer.length) {
        customer = customer[0];
        let contact = {};
        contact.id = customer.id;
        contact.name = customer.name;
        let activityId = Xrm.Page.data.entity.getId();
        var message = {};
        message.messageName = "ChatActivityCustomerUpdated";
        message.data = { activityId : activityId, customer: contact };
        var messageString = JSON.stringify(message);
        var frames = window.top.frames;
        for (var i = frames.length - 1; i >= 0; i--) {
            try {
                frames[i].postMessage(messageString, topMostWindow.agentWidgetUrl);
            }
            catch (e) {
                console.log(e);
            }
        }
    }
    else {
        console.log("failed to get customer details to update chat activity");
    }
};

//OnLoad function to set the SRC url for "ChatActivity" IFrame.
Chat.ChatActivityOnload = function () {
    try {
        var activityId = Xrm.Page.data.entity.getId().replace("{", "").replace("}", "");
        var stateCode = Xrm.Page.data.entity.attributes.get("statecode").getValue();
        var chattranscripturl = Xrm.Page.data.entity.attributes.get("cxlvhlp_chattranscripturl").getValue();

        // StateCode 1 == completed
        if (activityId && stateCode && stateCode == 1 && chattranscripturl) {
            getChatTranscriptId(activityId, function(transcriptId) {
                let transcriptWebResourceUrl = Xrm.Page.context.getClientUrl() + "/WebResources/cxlvhlp_/HTML/chat_transcript.html#";
                transcriptWebResourceUrl += "startTime=" + Xrm.Page.getAttribute("cxlvhlp_chatstarttime").getValue().getTime() + "&";
                transcriptWebResourceUrl += "endTime=" + Xrm.Page.getAttribute("cxlvhlp_chatendtime").getValue().getTime() + "&";
                transcriptWebResourceUrl += "transcriptId=" + transcriptId;

                Xrm.Page.ui.controls.get("IFRAME_ChatActivity").setVisible(true);
                Xrm.Page.ui.controls.get("IFRAME_ChatActivity").setSrc(transcriptWebResourceUrl);
            }, function(error) {
                console.log(error);
                showLegacyTranscript();
            })

            try {
                // format values stored as bytes
                formatMobileQuickViewByteFields();
            } catch (e) {
                console.log("Could not format the mobile memory and storage values. Error: ", e);
            }
        }

    }
    catch (ex) {
        console.log(ex.toString());
    }

    function showLegacyTranscript() {
        var transcriptUrl = Xrm.Page.getAttribute("cxlvhlp_chattranscripturl").getValue();

        Xrm.Page.ui.controls.get("IFRAME_ChatActivity").setVisible(true);
        Xrm.Page.ui.controls.get("IFRAME_ChatActivity").setSrc(transcriptUrl + "&lcid=" + Xrm.Page.context.getUserLcid());
    }

    function getChatTranscriptId(activityId, successCallback, errorCallback) {
        var query = "/api/data/v9.1/cxlvhlp_chatactivities(" + activityId + ")?$select=_cxlvhlp_chattranscript_value";
        Chat.GetHttpRequest(query,
            function success(data) {
                var parsedData = JSON.parse(data);
                if (parsedData && parsedData._cxlvhlp_chattranscript_value) {
                    successCallback(parsedData._cxlvhlp_chattranscript_value);
                }
                else {
                    showLegacyTranscript();
                }
            },
            function error(data) {
                errorCallback("Error while fetching the chat transcript" + " – " + data);
            });
    }

    function formatMobileQuickViewByteFields() {
        let mobileQuickViewForm = Xrm.Page.ui.quickForms.get("MobileContextQuickView");
        if (mobileQuickViewForm && mobileQuickViewForm.isLoaded()) {
            let freeMemoryValue = mobileQuickViewForm.getControl("cxlvhlp_freememory").getAttribute().getValue();
            let freeStorageValue = mobileQuickViewForm.getControl("cxlvhlp_freestorage").getAttribute().getValue();
            let totalMemoryValue = mobileQuickViewForm.getControl("cxlvhlp_totalmemory").getAttribute().getValue();
            let totalStorageValue = mobileQuickViewForm.getControl("cxlvhlp_totalstorage").getAttribute().getValue();

            mobileQuickViewForm.getControl("cxlvhlp_freememory").getAttribute().setValue(formatBytes(freeMemoryValue, 2));
            mobileQuickViewForm.getControl("cxlvhlp_freestorage").getAttribute().setValue(formatBytes(freeStorageValue, 2));
            mobileQuickViewForm.getControl("cxlvhlp_totalmemory").getAttribute().setValue(formatBytes(totalMemoryValue, 2));
            mobileQuickViewForm.getControl("cxlvhlp_totalstorage").getAttribute().setValue(formatBytes(totalStorageValue, 2));
        } else {
            setTimeout(formatMobileQuickViewByteFields, 1000);
        }
    }

    function formatBytes(bytes, decimals) {
        if (bytes == 0) return '0 Bytes';
        var k = 1000,
            dm = decimals || 2,
            sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'],
            i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }
    if (Xrm.Page.getAttribute("cxlvhlp_customer") != null)
    {
        Chat.ChatActivityCustomerUpdated();
    }
};

