function hideSPFolder(executionContext) {

    let formContext = executionContext.getFormContext();	
    let formType = formContext.ui.getFormType();
    let tab = formContext.ui.tabs.get("general");
    let sectionObj = tab.sections.get("general_section_13");
    let urlValue = formContext.getAttribute("isa_liendepartagesharepoint").getValue();

    if(formType == 1)
        sectionObj.setVisible(true);
    else if(urlValue && urlValue != "" )
        sectionObj.setVisible(true);
    else
    {
        sectionObj.setVisible(false);
        formContext.ui.setFormNotification("Sharepoint folder creation is in progress, please refresh form.", "INFO", "sp");
    }	
}