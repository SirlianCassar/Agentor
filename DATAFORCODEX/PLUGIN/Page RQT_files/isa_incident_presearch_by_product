function preSearchByProduct(executionContext) {
    var formContext = executionContext.getFormContext();
    if (formContext.getAttribute("productid")) {
        var product = formContext.getAttribute("productid").getValue();
        if(formContext.getAttribute("isa_recherche_base_connaissances").getValue() == null)
        {
            if(product && product.length > 0)
                formContext.getAttribute("isa_recherche_base_connaissances").setValue(product[0].name);
            else
                formContext.getAttribute("isa_recherche_base_connaissances").setValue(formContext.getAttribute("isa_titre").getValue());
        }
       
    }
}