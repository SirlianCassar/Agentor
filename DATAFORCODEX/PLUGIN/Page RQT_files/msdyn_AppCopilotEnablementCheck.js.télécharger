async function isAppCopilotEnabled(){
   "use strict";
   var appCopilotEnabled = false;
   var copilotControl = await Xrm?.Internal?.getCopilot();
   if(copilotControl)
   {
      if ('isAppCopilotEnabled' in copilotControl && typeof copilotControl.isAppCopilotEnabled === 'function') {
         appCopilotEnabled = copilotControl.isAppCopilotEnabled();
       } else {
         Xrm?.Reporting?.reportFailure("GetCopilotControl: isAppCopilotEnabled", new Error("Copilot Control does not have isAppCopilotEnabled function"));
       }
   }
   else{
      Xrm?.Reporting?.reportFailure("GetCopilotControl: isAppCopilotEnabled", new Error("Copilot Control not found"));
   }
   
   return appCopilotEnabled;
}