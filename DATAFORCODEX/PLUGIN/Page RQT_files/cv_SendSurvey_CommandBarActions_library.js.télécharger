                if (selctedRecordCount == 1) {
                    Xrm.Page.getControl("tab1footernext").setDisabled(false);
                }
                else {
                    Xrm.Page.getControl("tab1footernext").setDisabled(true);
                }
            }, 50);
        };
        CommandBarActions.OnLoad_SendSurvey = function () {
            var contact = Xrm.Page.data.attributes.get("param_contactid").getValue();
            var account = Xrm.Page.data.attributes.get("param_accountid").getValue();
            var currentRecord = Xrm.Page.data.attributes.get("param_recordid").getValue();
            var valueToBeSet = null;
            switch (currentRecord[0].entityType.toLowerCase()) {
                case "contact":
                    valueToBeSet = contact;
                    break;
                case "account":
                case "opportunity":
                case "lead":
                case "incident":
                case "contract":
                    if (contact != null) {
                        valueToBeSet = contact;
                    }
                    else if (account != null) {
                        valueToBeSet = account;
                    }
                    break;
                default:
                    valueToBeSet = null;
                    break;
            }
            if (valueToBeSet != null) {
                var result = this.RecipientValidation(valueToBeSet);
                if (!(result[0]))
                    Xrm.Page.ui.setFormNotification(Xrm.Utility.getResourceString(CommandBarActions.WebResourceName, "SendSurvey_Recipient_NoEmail"), "WARNING", "WARN");
                if (result[1])
                    Xrm.Page.ui.setFormNotification(Xrm.Utility.getResourceString(CommandBarActions.WebResourceName, "SendSurvey_Recipient_Unsubscribed"), "WARNING", "WARN");
                if (!(result[0]) || result[1]) {
                    this.SetFieldValue("customerLookup", valueToBeSet);
                    CommandBarActions.SetFirstNameLastName(valueToBeSet);
                    Xrm.Page.getControl("tab1footersend").setDisabled(true);
                }
                else {
                    Xrm.Page.ui.clearFormNotification("WARN");
                    this.SetFieldValue("customerLookup", valueToBeSet);
                    CommandBarActions.SetFirstNameLastName(valueToBeSet);
                    Xrm.Page.getControl("tab1footersend").setDisabled(false);
                }
            }
            else
                Xrm.Page.getControl("tab1footersend").setDisabled(true);
        };
        CommandBarActions.RecipientValidation = function (valueToBeSet) {
            var flag = { 0: false, 1: false };
            if (!(valueToBeSet && valueToBeSet[0] && valueToBeSet[0].id)) {
                return flag;
            }
            var req = new XMLHttpRequest();
            req.open("GET", Xrm.Page.context.getClientUrl() + "/api/data/v9.1/" + valueToBeSet[0].entityType.toLowerCase() + "s?$select=emailaddress1&$filter=" + valueToBeSet[0].entityType.toLowerCase() + "id" + " eq '" + valueToBeSet[0].id + "'", false);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Prefer", "odata.include-annotations=\"*\"");
            req.onreadystatechange = function () {
                if (this.readyState === 4) {
                    req.onreadystatechange = null;
                    if (this.status === 200) {
                        var results = JSON.parse(this.response);
                        for (var i = 0; i < results.value.length; i++) {
                            CommandBarActions.emailId = results.value[i]["emailaddress1"];
                            if (CommandBarActions.emailId != null) {
                                flag[0] = true;
                                flag[1] = CommandBarActions.UnsubscribeValidation(CommandBarActions.emailId);
                            }
                        }
                    }
                    else {
                        Xrm.Utility.alertDialog(this.statusText);
                    }
                }
            };
            req.send();
            return flag;
        };
        CommandBarActions.UnsubscribeValidation = function (emailId) {
            var flag = false;
            var req = new XMLHttpRequest();
            req.open("GET", Xrm.Page.context.getClientUrl() + "/api/data/v9.1/msfp_unsubscribedrecipients?$select=msfp_name&$filter=msfp_emailaddress eq '" + emailId + "'", false);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Prefer", "odata.include-annotations=\"*\"");
            req.onreadystatechange = function () {
                if (this.readyState === 4) {
                    req.onreadystatechange = null;
                    if (this.status === 200) {
                        var results = JSON.parse(this.response);
                        if (results && results.value["length"] > 0)
                            flag = true;
                    }
                    else {
                        Xrm.Utility.alertDialog(this.statusText);
                    }
                }
            };
            req.send();
            return flag;
        };
        CommandBarActions.OnClick_Send = function () {
            var jsonData = new Array();
            var variables = [];
            var surveyName = null;
            var sourcesurveyidentifier = null;
            var surveyId = Xrm.Page.data.attributes.get("param_surveyid").getValue();
            var isIFrame = function (input) {
                return input !== null && input.tagName === 'IFRAME';
            };
            var req = new XMLHttpRequest();
            req.open("GET", Xrm.Page.context.getClientUrl() + "/api/data/v9.1/msfp_surveies?$select=msfp_variables,msfp_sourcesurveyidentifier,msfp_name&$filter=msfp_surveyid eq '" + surveyId + "'", false);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Prefer", "odata.include-annotations=\"*\"");
            req.onreadystatechange = function () {
                if (this.readyState === 4) {
                    req.onreadystatechange = null;
                    if (this.status === 200) {
                        var results = JSON.parse(this.response);
                        for (var i = 0, j = 0; i < results.value.length; i++) {
                            surveyName = results.value[i]["msfp_name"];
                            sourcesurveyidentifier = results.value[i]["msfp_sourcesurveyidentifier"];
                            variables = JSON.parse(results.value[i]["msfp_variables"]);
							if(variables != null) {
								for (var i = 0; i < variables.length; i++) {
									if (variables[i].pipeName == "First Name" || variables[i].pipeName == "Last Name")
										continue;
									var val;
									if(variables[i].pipeName == "locale") {
										var localeControl = Xrm.Page.ui.controls.get("localeoptionset");
										for (var locale = 0; locale < localeControl.getOptions().length; locale++) {
											if (localeControl.getOptions()[locale].value == localeControl.getAttribute().getValue())
												val = localeControl.getOptions()[locale].text;
										}
									} else {
										var id = "DynamicTextBox" + i;
										var data = window.parent.document.getElementById("IFRAME_SurveyVariables");
										if (isIFrame(data) && data.contentWindow) {
											val = (data.contentWindow.document.getElementById(id) != null) ? data.contentWindow.document.getElementById(id).value : "";
										}
									}

									var name = variables[i].pipeName;
									jsonData[j] = {};
									jsonData[j++][name] = val;
								}
							}
                        }
                    }
                    else {
                        Xrm.Utility.alertDialog(this.statusText);
                    }
                }
            };
            req.send();
            var control = Xrm.Page.ui.controls.get("customerLookup");
            var lookupValue = control.getAttribute().getValue();
            var firstNameControl = Xrm.Page.getControl("msfp_firstname");
            var firstName = firstNameControl.getAttribute().getValue();
            var lastNameControl = Xrm.Page.getControl("msfp_lastname");
            var lastname = lastNameControl.getAttribute().getValue();
            var emailTemplateControl = Xrm.Page.ui.controls.get("emailtemplateoptionset");
            var emailtemplateid = null;
            for (var i = 0; i < CommandBarActions.emailTemplateObj.length; i++) {
                if (CommandBarActions.emailTemplateObj[i].value == emailTemplateControl.getAttribute().getValue())
                    emailtemplateid = CommandBarActions.emailTemplateObj[i].id;
            }
            var projectId = CommandBarActions.GetProjectId(surveyId);
			var localeName = null;
			var localeControl = Xrm.Page.ui.controls.get("localeoptionset");
			for (var locale = 0; locale < localeControl.getOptions().length; locale++) {
				if (localeControl.getOptions()[locale].value == localeControl.getAttribute().getValue())
					localeName = localeControl.getOptions()[locale].text;
			}
			if(emailTemplateControl.getAttribute().getValue() == null || localeControl.getAttribute().getValue() == null)
				Xrm.Utility.alertDialog(Xrm.Utility.getResourceString(CommandBarActions.WebResourceName, "SendSurvey_MandatoryFields_Validation"));
			else
			{
				var regardingId = Xrm.Page.data.attributes.get("param_recordid").getValue()[0].id.replace('{','').replace('}','');
				var regardingEntity = Xrm.Page.data.attributes.get("param_recordid").getValue()[0].entityType;
				var entity = {
					msfp_name: surveyName + " " + (firstName != null ? firstName.toString() : "") + " " + (lastname != null ? lastname.toString() : ""),
					msfp_emailtemplateid: emailtemplateid,
					msfp_surveyid: sourcesurveyidentifier != null ? sourcesurveyidentifier : null,
					msfp_to: CommandBarActions.emailId != null ? CommandBarActions.emailId : null,
					msfp_firstname: firstName != null ? firstName.toString() : null,
					msfp_lastname: lastname != null ? lastname.toString() : null,
					msfp_surveyvariablesjson: (JSON.stringify(jsonData) != null) && jsonData.length > 0 ? JSON.stringify(jsonData) : "[]",
					msfp_projectid: projectId,
					msfp_locale: localeName,
					msfp_regarding: regardingEntity + "," + regardingId
				};
				entity.msfp_surveyvariablesjson = entity.msfp_surveyvariablesjson.replaceAll('{','').replaceAll('}','').replaceAll('[','{').replaceAll(']','}');
				Xrm.WebApi.online.createRecord("msfp_customervoiceprocessor", entity).then(function success(result) {
					var newEntityId = result.id;
					if (newEntityId) {
						Xrm.Page.ui.close();
						Xrm.UI.addGlobalNotification(1, 4, Xrm.Utility.getResourceString(CommandBarActions.WebResourceName, "SendSurvey_SendButton_OnClickMessage"), null, null, null);
					}
				}, function (error) {
					Xrm.Utility.alertDialog(error.message);
				});
			}
        };
