        CommandBarActions.ShowHideSurveyButton = function (SelectedEntityTypeName) {
            if (Xrm.Internal.isUci()) {
                var flag = false;
                if (SelectedEntityTypeName == "contact" || SelectedEntityTypeName == "account" || SelectedEntityTypeName == "lead" || SelectedEntityTypeName == "opportunity" || SelectedEntityTypeName == "incident" || SelectedEntityTypeName == "contract")
                    return true;
                var req = new XMLHttpRequest();
                req.open("GET", Xrm.Page.context.getClientUrl() + "/api/data/v9.1/EntityDefinitions(LogicalName='" + SelectedEntityTypeName + "')?$select=LogicalName,IsCustomEntity,HasNotes", false);
                req.setRequestHeader("OData-MaxVersion", "4.0");
                req.setRequestHeader("OData-Version", "4.0");
                req.setRequestHeader("Accept", "application/json");
                req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
                req.setRequestHeader("Prefer", "odata.include-annotations=\"*\"");
                req.onreadystatechange = function () {
                    if (this.readyState === 4) {
                        req.onreadystatechange = null;
                        if (this.status === 200) {
                            var result = JSON.parse(this.response);
                            var isHasNotes = result["HasNotes"];
                            var IsCustomEntity = result["IsCustomEntity"];
                            if (IsCustomEntity && isHasNotes)
                                flag = true;
                        }
                        else {
                            Xrm.log('Sendsurvey is not available for ' + SelectedEntityTypeName + ' due to ' + this.statusText);
                        }
                    }
                };
                req.send();
                return flag;
            }
            else
                return false;
        };
        CommandBarActions.PopulateLookUp = function (executionContext) {
            var formContext = (executionContext && typeof (executionContext.getFormContext) == "function") ? executionContext.getFormContext() : executionContext;
            var lookupValue = new Array();
            lookupValue[0] = new Object();
            lookupValue[0].id = Xrm.Page.data.entity.getId();
            lookupValue[0].entityType = formContext.entityReference.entityType;
            var nameOfRecord = this.GetCurrentRecordName(formContext);
            lookupValue[0].name = nameOfRecord;
            return lookupValue;
        };
        CommandBarActions.GetCurrentRecordName = function (executionContext) {
            var formContext = (executionContext && typeof (executionContext.getFormContext) == "function") ? executionContext.getFormContext() : executionContext;
            var currentEntity = formContext.data.entity.getEntityName();
            var nameOfRecord = "";
            var firstName = "";
            var lastName = "";
            switch (currentEntity.toLowerCase()) {
                case "account":
                    nameOfRecord = formContext.getAttribute("name").getValue();
                    break;
                case "contact":
                    firstName = formContext.getAttribute("firstname").getValue();
                    lastName = formContext.getAttribute("lastname").getValue();
                    if (firstName != null && firstName != "") {
                        nameOfRecord = firstName;
                    }
                    if (lastName != null && lastName != "") {
                        nameOfRecord = nameOfRecord + " " + lastName;
                    }
                    break;
                case "lead":
                    firstName = formContext.getAttribute("firstname").getValue();
                    lastName = formContext.getAttribute("lastname").getValue();
                    if (firstName != null && firstName != "") {
                        nameOfRecord = firstName;
                    }
                    if (lastName != null && lastName != "") {
                        nameOfRecord = nameOfRecord + " " + lastName;
                    }
                    break;
                default:
                    nameOfRecord = "";
                    break;
            }
            return nameOfRecord;
        };
