var SendSurveyService;
(function (SendSurveyService) {
    var CommandBarActions = (function () {
        function CommandBarActions() {
            var global = window;
        }
        CommandBarActions.OpenDialog = function (executionContext) {
            var surveydialogArguments = {
                param_recordid: null,
                param_accountid: null,
                param_contactid: null,
                param_ownerid: null,
                param_surveyid: null,
                param_parentcontext: null
            };
            var formContext = (executionContext && typeof (executionContext.getFormContext) == "function") ? executionContext.getFormContext() : executionContext;
            var owner = this.GetLookupValueFromContext(formContext, "ownerid");
            var account = this.GetLookupValueFromContext(formContext, "parentaccountid");
            var contact = this.GetLookupValueFromContext(formContext, "parentcontactid");
            var currentRecord = this.PopulateLookUp(formContext);
            surveydialogArguments["param_ownerid"] = (owner != null) ? owner : null;
            surveydialogArguments["param_recordid"] = currentRecord;
            surveydialogArguments["param_parentcontext"] = executionContext;
            var currentEntity = formContext.data.entity.getEntityName();
            switch (currentEntity.toLowerCase()) {
                case "contact":
                    surveydialogArguments["param_accountid"] = null;
                    surveydialogArguments["param_contactid"] = currentRecord;
                    break;
                case "account":
                    contact = this.GetLookupValueFromContext(formContext, "primarycontactid");
                    if (contact != null) {
                        surveydialogArguments["param_accountid"] = null;
                        surveydialogArguments["param_contactid"] = contact;
                    }
                    else {
                        surveydialogArguments["param_accountid"] = currentRecord;
                        surveydialogArguments["param_contactid"] = null;
                    }
                    break;
                case "opportunity":
                    surveydialogArguments["param_accountid"] = (account != null) ? account : null;
                    surveydialogArguments["param_contactid"] = (contact != null) ? contact : null;
                    break;
                case "lead":
                    surveydialogArguments["param_accountid"] = (account != null) ? account : null;
                    surveydialogArguments["param_contactid"] = (contact != null) ? contact : null;
                    break;
                case "contract":
                    account = this.GetLookupValueFromContext(formContext, "customerid");
                    if (account[0].entityType == "contact") {
                        contact = account;
                        account = null;
                    }
                    surveydialogArguments["param_accountid"] = (account != null) ? account : null;
                    surveydialogArguments["param_contactid"] = (contact != null) ? contact : null;
                    break;
                case "incident":
                    contact = this.GetLookupValueFromContext(formContext, "primarycontactid");
                    account = this.GetLookupValueFromContext(formContext, "customerid");
                    if (contact == null) {
                        if (account[0].entityType == "contact") {
                            contact = account;
                            account = null;
                        }
                    }
                    surveydialogArguments["param_accountid"] = (account != null) ? account : null;
                    surveydialogArguments["param_contactid"] = (contact != null) ? contact : null;
                    break;
                default:
                    surveydialogArguments["param_accountid"] = null;
                    surveydialogArguments["param_contactid"] = null;
                    break;
            }
            var dialogOptions = {
                position: 1,
                width: 900,
                height: 500
            };
            Xrm.Navigation.openDialog("CustomDialog", dialogOptions, surveydialogArguments);
            var interval = window.setInterval(function () {
                if (window.parent.document.querySelector("[data-id='CustomDialog']") != null && window.parent.document.querySelector("[data-id='CustomDialog'] [data-control-name='SurveySubgrid']") != null && window.parent.document.querySelector("[data-id='CustomDialog'] [data-control-name='SurveySubgrid'] [data-id='msfp_friendlyname']") != null) {
                    CommandBarActions.Onload_Subgrid();
                    clearInterval(interval);
                }
            }, 50);
        };
        CommandBarActions.OnLoad_Survey = function () {
            window.setInterval(function () {
                var selctedRecords = Xrm.Page.getControl("SurveySubgrid").getGrid().getSelectedRows();
                var selctedRecordCount = selctedRecords.getLength();
                var control = window.parent.document.querySelector("[data-lp-id='SubGridStandard:msfp_survey-OverflowButton']");
                var controlForSeeAllRecords = window.parent.document.querySelector("[aria-label='See all records']");
