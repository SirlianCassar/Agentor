function onLoad(executionContext)
{
    var formContext = executionContext.getFormContext();
    var origine = formContext.getAttribute("caseorigincode").getValue();
    var ownerCrmJetty = formContext.getAttribute("isa_owner_crm_jetty").getValue();
    if((origine === 3 || origine === 863150000 || origine === 1 )&& ownerCrmJetty)
    {
        var userSettings = Xrm.Utility.getGlobalContext().userSettings;
        var user = {
            id: userSettings.userId, 
            name: userSettings.userName, 
            entityType: "systemuser"
        }
        formContext.getAttribute("ownerid").setValue([user]);
        formContext.getAttribute("isa_owner_crm_jetty").setValue(false);
        formContext.getAttribute("statuscode").setValue(1);
//        formContext.getAttribute("isa_categorie_support_agent").setRequiredLevel("none");
//        formContext.getAttribute("isa_detail_support_agent").setRequiredLevel("none");
//        formContext.getAttribute("isa_sousdetailagent").setRequiredLevel("none");
        formContext.data.save().then(displayNotification);
    }
}

function displayNotification()
{
    formContext.ui.setFormNotification("L'incident vous a été attribué ", "INFO");    
}