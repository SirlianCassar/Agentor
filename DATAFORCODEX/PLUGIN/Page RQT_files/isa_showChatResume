    function showChat(executionContext)
    {
    	'use strict'
    	var formContext = executionContext.getFormContext();
    	if (formContext.getControl("isa_urlconversation"))
    	{
    		var url = formContext.getControl("isa_urlconversation").getValue();
    		if (url && url !== "" && formContext.getControl("IFRAME_conversation"))
    		{
    			formContext.getControl("IFRAME_conversation").setVisible(true);
    			formContext.getControl("IFRAME_conversation").setSrc(url);
    		}
    	}
    }